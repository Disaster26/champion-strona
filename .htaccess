# Nauka Jazdy Champion - konfiguracja dla serwera Apache (docelowy hosting).
# Na GitHub Pages ten plik jest pomijany.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. HTTPS i jeden adres: https://champion-witnica.pl (bez www, inne domeny przekierowane)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^champion-witnica\.pl$ [NC]
RewriteRule ^(.*)$ https://champion-witnica.pl/$1 [R=301,L]

# 2. Stare adresy WordPressa -> nowe strony
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^kontakt-2/?$ /kontakt/ [R=301,L]
RewriteRule ^polityka-cookies/?$ /polityka-prywatnosci/ [R=301,L]
RewriteRule ^(oferta|galeria|kontakt|cennik|polityka-prywatnosci)$ /$1/ [R=301,L]
RewriteRule ^wp-content/uploads/sites/812/.*[Ss]tandardy-ochrony.*\.pdf$ /dokumenty/standardy-ochrony-maloletnich.pdf [R=301,L,NC]
RewriteRule ^wp-content/uploads/ /galeria/ [R=301,L]
RewriteRule ^(wp-sitemap|sitemap_index|page-sitemap)[^/]*\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(portfolio-item|portfolio-types|author)(/.*)?$ / [R=301,L]
RewriteRule ^feed/?$ / [R=301,L]
RewriteRule ^comments/feed/?$ / [R=301,L]
RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/.*)?$ - [G,L]
RewriteRule ^(wp-login|xmlrpc|wp-load|wp-cron)\.php$ - [G,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)= [NC]
RewriteRule ^$ /? [R=301,L]
</IfModule>

# 3. Pamiec podreczna przegladarki
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType application/pdf "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp
